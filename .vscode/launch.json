{
    "version": "0.2.0",
    "configurations": [
        {
            "name": "Attach a Eden (GDB)",
            "type": "cppdbg",
            "request": "launch",
            "miDebuggerPath": "D:/SwitchDevkit/devkitA64/bin/aarch64-none-elf-gdb.exe", 
            "miDebuggerServerAddress": "localhost:6543",
            "stopAtEntry": false,
            "cwd": "${workspaceFolder}",
            "externalConsole": false,
            "MIMode": "gdb",
            "setupCommands": [
                {
                    "description": "Habilitar Pretty-printing para gdb",
                    "text": "-enable-pretty-printing",
                    "ignoreFailures": true
                },
                {
                    "description": "Forzar arquitectura aarch64",
                    "text": "set architecture aarch64",
                    "ignoreFailures": false
                }
            ],
            "program": "D:/Clase/eden/test01Window.elf" 
        }
    ]
}